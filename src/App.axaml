<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AnimeNotepad.App"
             RequestedThemeVariant="Light">
             <!-- Forced to Light theme to match classic Notepad aesthetic and avoid white-on-white text issues -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>