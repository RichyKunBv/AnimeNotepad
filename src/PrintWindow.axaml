<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="350"
        x:Class="AnimeNotepad.PrintWindow"
        Title="Imprimir"
        Width="500" Height="350"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#F0F0F0">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Impresora -->
        <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,0,0,10" Background="White">
            <StackPanel>
                <TextBlock Text="Impresora" FontWeight="Bold" Margin="0,0,0,10" Foreground="Black"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Nombre:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="Black"/>
                    <ComboBox Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" Margin="0,0,10,0">
                        <ComboBoxItem>Impresora por defecto del sistema</ComboBoxItem>
                    </ComboBox>
                    <Button Grid.Column="2" Content="Propiedades..." Width="100" HorizontalContentAlignment="Center"/>
                </Grid>
                
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Estado:" Width="70" Foreground="Black"/>
                    <TextBlock Text="Listo" Foreground="Black"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Tipo:" Width="70" Foreground="Black"/>
                    <TextBlock Text="Impresora Local" Foreground="Black"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Ubicación:" Width="70" Foreground="Black"/>
                    <TextBlock Text="Local" Foreground="Black"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Intervalo de impresión y Copias -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*">
            
            <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,0,5,0" Background="White">
                <StackPanel>
                    <TextBlock Text="Intervalo de impresión" FontWeight="Bold" Margin="0,0,0,10" Foreground="Black"/>
                    <RadioButton Content="Todo" IsChecked="True" Foreground="Black" Margin="0,0,0,5"/>
                    <RadioButton Content="Selección" IsEnabled="False" Foreground="Black" Margin="0,0,0,5"/>
                    <RadioButton Content="Páginas" IsEnabled="False" Foreground="Black"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="5,0,0,0" Background="White">
                <StackPanel>
                    <TextBlock Text="Copias" FontWeight="Bold" Margin="0,0,0,10" Foreground="Black"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Número de copias:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="Black"/>
                        <NumericUpDown Minimum="1" Maximum="100" Value="1" Width="70" FormatString="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Botones Aceptar / Cancelar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
            <Button Content="Aceptar" Click="Aceptar_Click" Width="90" HorizontalContentAlignment="Center"/>
            <Button Content="Cancelar" Click="Cancelar_Click" Width="90" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
