<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AnimeNotepad.Views.Password.PasswordWindow"
        Title="Contraseña" Width="390" Height="190"
        WindowStartupLocation="CenterOwner" CanResize="False">
    <Grid RowDefinitions="Auto,Auto,Auto" Margin="18">
        <TextBlock Name="PromptText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBox Name="PasswordTextBox" Grid.Row="1" PasswordChar="●" KeyDown="PasswordTextBox_KeyDown" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="Cancelar" Click="CancelButton_Click" MinWidth="90" />
            <Button Content="Aceptar" Click="AcceptButton_Click" MinWidth="90" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>